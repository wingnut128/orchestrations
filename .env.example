# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=

# GitHub (or a GitHub-compatible forge like Forgejo/Gitea)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_GIT_URL=https://github.com
# For an isolated local Forgejo (docker compose --profile forgejo up -d):
#   GITHUB_API_URL=http://forgejo:3000/api/v1   # http://localhost:3000/api/v1 from host
#   GITHUB_GIT_URL=http://forgejo:3000          # http://localhost:3000 from host

# Anthropic
ANTHROPIC_API_KEY=

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=orchestrations
